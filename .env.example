# ══════════════════════════════════════════════════════════════════
#  Kopiér denne fil til ".env" og udfyld den. .env må ALDRIG deles.
#  Alle Square-værdier hentes på https://app.squareup.com/
# ══════════════════════════════════════════════════════════════════

# Developer → din app → Credentials → "Access token"  (starter med EAAA…)
# OBS: Application ID'et (sq0idp-…) er IKKE et access token.
SQUARE_ACCESS_TOKEN=EAAA…

# Developer → din app → Locations → Location ID
SQUARE_LOCATION_ID=L56T6E4PA9CF6

# "sandbox" mens du tester · "production" når I går live
SQUARE_ENV=sandbox

# Gmail-konto der sender kvitteringer + et app-kodeord (ikke dit almindelige kodeord)
# https://myaccount.google.com/apppasswords
MAIL_USER=sorensenitreparation670@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx

# Domænet websitet ligger på (bruges til CORS)
SITE_URL=https://sorensen-it.dk

# Valgfri port (standard 3000)
# PORT=3000
